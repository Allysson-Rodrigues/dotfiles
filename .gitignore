# ==============================================================================
# Security: NEVER track secrets, keys, tokens, or credentials
# ==============================================================================

# SSH keys and auth
*.pem
*.key
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub
*_ecdsa
*_ecdsa.pub
*.p12
*.pfx
id_*
known_hosts*
authorized_keys
allowed_signers

# GPG
*.gpg
*.asc
secring.*
pubring.*
trustdb.gpg
random_seed
private-keys-v1.d/

# Credentials and tokens
password
password.txt
*.password
credentials*
token*
*.token
*.secret
.env
.env.*
auth.json
rclone.conf
config_default
cookie*

# Shell history
.*_history
.zsh_history
.bash_history

# Compiled and cache files
*.zwc
.zcompdump*
.cache/
__pycache__/
node_modules/

# OS artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~
