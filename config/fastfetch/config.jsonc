{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " 󰄾 "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "Host ",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "magenta"
    },
    {
      "type": "de",
      "key": "DE   ",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "WM   ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "Term ",
      "keyColor": "red"
    },
    {
      "type": "cpu",
      "key": "CPU  ",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "GPU  ",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "RAM  ",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "yellow"
    },
    "break",
    "colors"
  ]
}
