# bat configuration
# See: https://github.com/sharkdp/bat#configuration-file

--theme="base16-256"
--style="numbers,changes,header"
--italic-text=always

# Syntax mappings for files bat doesn't detect automatically
--map-syntax="*.jenkinsfile:Groovy"
--map-syntax="*.mjs:JavaScript"
--map-syntax="*.mts:TypeScript"
--map-syntax="*.jsonc:JSON"
--map-syntax=".env*:Bourne Again Shell (bash)"
