# ==============================================================================
# Ghostty Terminal Configuration (Optimized for Fedora Workstation & GNOME)
# ==============================================================================

# --- Typography & Rendering ---
font-family = "JetBrainsMono Nerd Font"
font-size = 13
font-thicken = false
adjust-cell-height = 8%
font-feature = calt, liga

# --- Window & Appearance ---
theme = "light:Adwaita,dark:Adwaita Dark"
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
gtk-titlebar = true
gtk-tabs-location = top
background-opacity = 0.90
background-blur = true
unfocused-split-opacity = 0.85
window-inherit-working-directory = true
window-save-state = "always"

# --- Cursor & Mouse ---
cursor-style = "bar"
cursor-style-blink = false
cursor-opacity = 1.0
cursor-click-to-move = true
mouse-hide-while-typing = true

# --- Performance & System (Fedora / GNOME / Wayland) ---
gtk-single-instance = true
linux-cgroup = single-instance
link-url = true

# --- Behavior & Shell Integration ---
copy-on-select = clipboard
clipboard-paste-protection = false
right-click-action = context-menu
confirm-close-surface = true
shell-integration = detect
shell-integration-features = cursor,sudo,title,path
minimum-contrast = 1.0
quit-after-last-window-closed = true

# --- Scrollback ---
scrollback-limit = 200000

# --- Keybindings ---
# Window & Tab Management
keybind = ctrl+shift+enter=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+r=reload_config

# Tab Direct Navigation
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=last_tab

# Splits Management
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+shift+s=new_split:right
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+[=goto_split:previous
keybind = ctrl+shift+]=goto_split:next

# Split Navigation (Vim-style)
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up

# Split Resizing
keybind = ctrl+alt+h=resize_split:left,10
keybind = ctrl+alt+l=resize_split:right,10
keybind = ctrl+alt+k=resize_split:up,10
keybind = ctrl+alt+j=resize_split:down,10

# Search & Prompt Navigation
keybind = ctrl+shift+f=start_search
keybind = ctrl+shift+page_up=jump_to_prompt:-1
keybind = ctrl+shift+page_down=jump_to_prompt:1

# Clipboard & View
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+n=scroll_to_bottom
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+home=scroll_to_top
keybind = ctrl+shift+backspace=clear_screen

# Font Size Controls
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+zero=reset_font_size
