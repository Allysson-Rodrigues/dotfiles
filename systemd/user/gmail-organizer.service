[Unit]
Description=Gmail Auto-Maintenance and Inbox Zero Service
After=network-online.target

[Service]
Type=oneshot
Environment="PYTHONUNBUFFERED=1"
TimeoutStartSec=300
ExecStart=/home/allyssonrodrigues/gmail-organizer/run_maintenance.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
